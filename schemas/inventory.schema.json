{
  "$defs": {
    "AccountScope": {
      "enum": [
        "MACHINE",
        "USER"
      ],
      "type": "string"
    },
    "Architecture": {
      "enum": [
        "ARM64",
        "NEUTRAL",
        "UNKNOWN",
        "X64",
        "X86"
      ],
      "type": "string"
    },
    "ArtifactId": {
      "description": "Opaque artifact identifier. Its value is validated for safe wire transport.",
      "type": "string"
    },
    "ArtifactPolicy": {
      "enum": [
        "CONFIG",
        "DATA",
        "EXPORT",
        "LARGE_OPT_IN",
        "MANUAL",
        "PORTABLE_BINARY",
        "SECRET_REFERENCE"
      ],
      "type": "string"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "content_type": {
          "$ref": "#/$defs/ContentType"
        },
        "id": {
          "$ref": "#/$defs/ArtifactId"
        },
        "object": {
          "anyOf": [
            {
              "$ref": "#/$defs/ObjectId"
            },
            {
              "type": "null"
            }
          ]
        },
        "policy": {
          "$ref": "#/$defs/ArtifactPolicy"
        },
        "scope": {
          "$ref": "#/$defs/ConfigScope"
        },
        "size_bytes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "source_path": {
          "$ref": "#/$defs/PathTokenInput"
        }
      },
      "required": [
        "content_type",
        "id",
        "policy",
        "scope",
        "size_bytes",
        "source_path"
      ],
      "type": "object"
    },
    "Compatibility": {
      "additionalProperties": false,
      "properties": {
        "required_architecture": {
          "anyOf": [
            {
              "$ref": "#/$defs/Architecture"
            },
            {
              "type": "null"
            }
          ]
        },
        "required_os": {
          "type": [
            "null",
            "string"
          ]
        },
        "requires_docker": {
          "type": "boolean"
        },
        "requires_elevation": {
          "type": "boolean"
        },
        "requires_provider": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProviderId"
            },
            {
              "type": "null"
            }
          ]
        },
        "requires_runtime": {
          "anyOf": [
            {
              "$ref": "#/$defs/ComponentId"
            },
            {
              "type": "null"
            }
          ]
        },
        "requires_wsl": {
          "type": "boolean"
        }
      },
      "required": [
        "requires_docker",
        "requires_elevation",
        "requires_wsl"
      ],
      "type": "object"
    },
    "Component": {
      "additionalProperties": true,
      "properties": {
        "architecture": {
          "anyOf": [
            {
              "$ref": "#/$defs/Architecture"
            },
            {
              "type": "null"
            }
          ]
        },
        "artifacts": {
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "type": "array"
        },
        "compatibility": {
          "$ref": "#/$defs/Compatibility"
        },
        "confidence": {
          "$ref": "#/$defs/Confidence"
        },
        "dependencies": {
          "items": {
            "$ref": "#/$defs/DependencyEdge"
          },
          "type": "array"
        },
        "display_name": {
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "type": "array"
        },
        "id": {
          "$ref": "#/$defs/ComponentId"
        },
        "identity": {
          "$ref": "#/$defs/Identity"
        },
        "kind": {
          "$ref": "#/$defs/ComponentKind"
        },
        "provenance": {
          "anyOf": [
            {
              "$ref": "#/$defs/Provenance"
            },
            {
              "type": "null"
            }
          ]
        },
        "publisher": {
          "anyOf": [
            {
              "$ref": "#/$defs/Publisher"
            },
            {
              "type": "null"
            }
          ]
        },
        "restore": {
          "$ref": "#/$defs/RestoreDescriptor"
        },
        "selection": {
          "$ref": "#/$defs/SelectionMetadata"
        },
        "verification": {
          "items": {
            "$ref": "#/$defs/VerificationRule"
          },
          "type": "array"
        },
        "version": {
          "anyOf": [
            {
              "$ref": "#/$defs/VersionValue"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "artifacts",
        "compatibility",
        "confidence",
        "dependencies",
        "display_name",
        "evidence",
        "id",
        "identity",
        "kind",
        "restore",
        "selection",
        "verification"
      ],
      "type": "object"
    },
    "ComponentId": {
      "description": "Stable component identity: `cmp_` followed by lowercase unpadded Base32 BLAKE3-256.",
      "type": "string"
    },
    "ComponentKind": {
      "enum": [
        "AGENT",
        "APPLICATION",
        "BROWSER",
        "BROWSER_PROFILE",
        "CONFIGURATION",
        "DATA_ARTIFACT",
        "DOCKER_CONTEXT",
        "DOCKER_IMAGE",
        "DOCKER_VOLUME",
        "EDITOR",
        "ENVIRONMENT_VARIABLE",
        "EXTENSION",
        "HARNESS",
        "HOOK",
        "MCP_SERVER",
        "PACKAGE",
        "PLUGIN",
        "PORTABLE_BINARY",
        "RUNTIME",
        "SCHEDULED_TASK",
        "SECRET_REFERENCE",
        "SERVICE",
        "SHELL",
        "SKILL",
        "SYSTEM_FEATURE",
        "TOOL",
        "UNKNOWN",
        "WSL_DISTRIBUTION"
      ],
      "type": "string"
    },
    "Confidence": {
      "enum": [
        "CONFIRMED",
        "HIGH",
        "LOW",
        "MEDIUM",
        "UNKNOWN"
      ],
      "type": "string"
    },
    "ConfigScope": {
      "enum": [
        "MANAGED",
        "PROCESS",
        "PROJECT",
        "SYSTEM",
        "USER"
      ],
      "type": "string"
    },
    "ContentType": {
      "enum": [
        "ARCHIVE",
        "BINARY",
        "JSON",
        "JSONC",
        "TOML",
        "UNKNOWN",
        "UTF8_TEXT"
      ],
      "type": "string"
    },
    "DependencyEdge": {
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "$ref": "#/$defs/Confidence"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/EvidenceId"
          },
          "type": "array"
        },
        "from": {
          "$ref": "#/$defs/ComponentId"
        },
        "kind": {
          "$ref": "#/$defs/DependencyKind"
        },
        "required": {
          "type": "boolean"
        },
        "to": {
          "$ref": "#/$defs/ComponentId"
        }
      },
      "required": [
        "confidence",
        "evidence",
        "from",
        "kind",
        "required",
        "to"
      ],
      "type": "object"
    },
    "DependencyKind": {
      "enum": [
        "CONFIGURES",
        "CONTAINS",
        "INSTALLED_THROUGH",
        "OPTIONAL_FEATURE",
        "PROVIDES_EXECUTABLE",
        "RELATED_ONLY",
        "REQUIRED_PACKAGE",
        "REQUIRED_RUNTIME",
        "RESTORES_BEFORE",
        "USES_SECRET",
        "VERIFIES_WITH"
      ],
      "type": "string"
    },
    "DriveFact": {
      "additionalProperties": false,
      "properties": {
        "filesystem": {
          "type": [
            "null",
            "string"
          ]
        },
        "token": {
          "type": "string"
        }
      },
      "required": [
        "token"
      ],
      "type": "object"
    },
    "DriveFreeSpace": {
      "additionalProperties": false,
      "properties": {
        "bytes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "token": {
          "type": "string"
        }
      },
      "required": [
        "bytes",
        "token"
      ],
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/EvidenceId"
        },
        "independent_group": {
          "type": "string"
        },
        "locator": {
          "type": "string"
        },
        "observed_at": {
          "format": "date-time",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/EvidenceSource"
        },
        "strength": {
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "summary": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "independent_group",
        "locator",
        "observed_at",
        "source",
        "strength",
        "summary"
      ],
      "type": "object"
    },
    "EvidenceId": {
      "description": "Opaque evidence identifier. Its value is validated for safe wire transport.\nOpaque provider identifier. Its value is validated for safe wire transport.",
      "type": "string"
    },
    "EvidenceRef": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/EvidenceId"
        },
        "strength": {
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "strength"
      ],
      "type": "object"
    },
    "EvidenceSource": {
      "enum": [
        "APP_PATHS",
        "AUTHENTICODE",
        "BROWSER",
        "BUN",
        "CHOCOLATEY",
        "DOCKER",
        "DOTNET",
        "EDITOR",
        "FILE_METADATA",
        "GO",
        "HARNESS",
        "NPM",
        "PNPM",
        "POWER_SHELL",
        "PYTHON",
        "REGISTRY",
        "RUST",
        "SCOOP",
        "SHORTCUT",
        "UNKNOWN",
        "USER_SELECTED",
        "WIN_GET",
        "WSL",
        "YARN"
      ],
      "type": "string"
    },
    "HostFacts": {
      "additionalProperties": false,
      "properties": {
        "account_scope": {
          "$ref": "#/$defs/AccountScope"
        },
        "architecture": {
          "$ref": "#/$defs/Architecture"
        },
        "drives": {
          "items": {
            "$ref": "#/$defs/DriveFact"
          },
          "type": "array"
        },
        "elevated": {
          "type": "boolean"
        },
        "free_bytes": {
          "items": {
            "$ref": "#/$defs/DriveFreeSpace"
          },
          "type": "array"
        },
        "known_folders": {
          "items": {
            "$ref": "#/$defs/PathTokenInput"
          },
          "type": "array"
        },
        "os_build": {
          "type": "string"
        },
        "os_version": {
          "type": "string"
        },
        "sid_fingerprint": {
          "type": [
            "null",
            "string"
          ]
        }
      },
      "required": [
        "account_scope",
        "architecture",
        "drives",
        "elevated",
        "free_bytes",
        "known_folders",
        "os_build",
        "os_version"
      ],
      "type": "object"
    },
    "Identity": {
      "additionalProperties": false,
      "properties": {
        "executable_hash": {
          "type": [
            "null",
            "string"
          ]
        },
        "executable_name": {
          "type": [
            "null",
            "string"
          ]
        },
        "identity_quality": {
          "$ref": "#/$defs/IdentityQuality"
        },
        "install_role": {
          "type": [
            "null",
            "string"
          ]
        },
        "package_family": {
          "type": [
            "null",
            "string"
          ]
        },
        "product_name": {
          "type": [
            "null",
            "string"
          ]
        },
        "provider_package": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "$ref": "#/$defs/ProviderId"
            },
            {
              "type": "string"
            }
          ],
          "type": [
            "array",
            "null"
          ]
        },
        "provider_source": {
          "type": [
            "null",
            "string"
          ]
        },
        "publisher": {
          "type": [
            "null",
            "string"
          ]
        }
      },
      "required": [
        "identity_quality"
      ],
      "type": "object"
    },
    "IdentityQuality": {
      "enum": [
        "LOCAL",
        "PACKAGE_FAMILY",
        "PRODUCT",
        "PROVIDER",
        "SIGNED_PRODUCT"
      ],
      "type": "string"
    },
    "KnownFolderToken": {
      "oneOf": [
        {
          "properties": {
            "content": {
              "properties": {
                "id": {
                  "type": "string"
                }
              },
              "required": [
                "id"
              ],
              "type": "object"
            },
            "type": {
              "const": "USER_SELECTED",
              "type": "string"
            }
          },
          "required": [
            "content",
            "type"
          ],
          "type": "object"
        },
        {
          "properties": {
            "type": {
              "const": "DESKTOP",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "properties": {
            "type": {
              "const": "DOCUMENTS",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "properties": {
            "type": {
              "const": "LOCAL_APP_DATA",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "properties": {
            "type": {
              "const": "PROGRAM_DATA",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "properties": {
            "type": {
              "const": "PROGRAM_FILES",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "properties": {
            "type": {
              "const": "PROGRAM_FILES_X86",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "properties": {
            "type": {
              "const": "ROAMING_APP_DATA",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "properties": {
            "type": {
              "const": "STARTUP",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "properties": {
            "type": {
              "const": "START_MENU",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "properties": {
            "type": {
              "const": "USER_PROFILE",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        }
      ]
    },
    "ObjectId": {
      "description": "Content-addressed object identity: `obj_` followed by lowercase hexadecimal BLAKE3-256.",
      "type": "string"
    },
    "PackageGraph": {
      "additionalProperties": false,
      "properties": {
        "components": {
          "items": {
            "$ref": "#/$defs/Component"
          },
          "type": "array"
        },
        "edges": {
          "items": {
            "$ref": "#/$defs/DependencyEdge"
          },
          "type": "array"
        }
      },
      "required": [
        "components",
        "edges"
      ],
      "type": "object"
    },
    "PackageSpec": {
      "additionalProperties": false,
      "properties": {
        "architecture": {
          "anyOf": [
            {
              "$ref": "#/$defs/Architecture"
            },
            {
              "type": "null"
            }
          ]
        },
        "id": {
          "type": "string"
        },
        "installer_hash": {
          "type": [
            "null",
            "string"
          ]
        },
        "provider": {
          "$ref": "#/$defs/ProviderId"
        },
        "source": {
          "format": "uri",
          "type": [
            "null",
            "string"
          ]
        },
        "source_identifier": {
          "type": [
            "null",
            "string"
          ]
        },
        "source_name": {
          "type": [
            "null",
            "string"
          ]
        },
        "version": {
          "type": [
            "null",
            "string"
          ]
        }
      },
      "required": [
        "id",
        "provider"
      ],
      "type": "object"
    },
    "PathTokenInput": {
      "additionalProperties": false,
      "properties": {
        "relative": {
          "type": "string"
        },
        "root": {
          "$ref": "#/$defs/KnownFolderToken"
        }
      },
      "required": [
        "relative",
        "root"
      ],
      "type": "object"
    },
    "Portability": {
      "enum": [
        "APPLICATION_BOUND",
        "MACHINE_BOUND",
        "PARTIALLY_PORTABLE",
        "PORTABLE",
        "REAUTH_REQUIRED",
        "SUPPORTED_EXPORT",
        "SYNC_RESTORABLE",
        "UNKNOWN",
        "UNSUPPORTED",
        "USER_BOUND"
      ],
      "type": "string"
    },
    "Provenance": {
      "additionalProperties": false,
      "properties": {
        "adapter_id": {
          "type": "string"
        },
        "adapter_version": {
          "type": "string"
        },
        "observed_version": {
          "type": [
            "null",
            "string"
          ]
        },
        "package_id": {
          "type": [
            "null",
            "string"
          ]
        },
        "provider": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProviderId"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_url": {
          "format": "uri",
          "type": [
            "null",
            "string"
          ]
        }
      },
      "required": [
        "adapter_id",
        "adapter_version"
      ],
      "type": "object"
    },
    "ProviderId": {
      "description": "Opaque provider identifier. Its value is validated for safe wire transport.",
      "type": "string"
    },
    "Publisher": {
      "additionalProperties": false,
      "properties": {
        "certificate_thumbprint": {
          "type": [
            "null",
            "string"
          ]
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "RestoreDescriptor": {
      "additionalProperties": false,
      "properties": {
        "alternatives": {
          "items": {
            "$ref": "#/$defs/RestoreStrategy"
          },
          "type": "array"
        },
        "portability": {
          "$ref": "#/$defs/Portability"
        },
        "primary": {
          "$ref": "#/$defs/RestoreStrategy"
        },
        "rationale": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "requires_elevation": {
          "type": "boolean"
        },
        "requires_user_action": {
          "type": "boolean"
        }
      },
      "required": [
        "alternatives",
        "portability",
        "primary",
        "rationale",
        "requires_elevation",
        "requires_user_action"
      ],
      "type": "object"
    },
    "RestoreStrategy": {
      "enum": [
        "CONFIG_PORTABLE",
        "DATA_PORTABLE",
        "EXPORT_IMPORT",
        "MACHINE_BOUND",
        "MANUAL",
        "PARTIAL",
        "PORTABLE_BINARY",
        "REAUTH_REQUIRED",
        "REINSTALL",
        "SECRET_EXPORTABLE",
        "UNKNOWN"
      ],
      "type": "string"
    },
    "RunId": {
      "description": "UUIDv7 run identifier used to correlate resumable operations and journal events.",
      "type": "string"
    },
    "SafeValueRef": {
      "oneOf": [
        {
          "properties": {
            "content": {
              "properties": {
                "id": {
                  "$ref": "#/$defs/ComponentId"
                },
                "label": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "label"
              ],
              "type": "object"
            },
            "type": {
              "const": "SECRET_REFERENCE",
              "type": "string"
            }
          },
          "required": [
            "content",
            "type"
          ],
          "type": "object"
        },
        {
          "properties": {
            "content": {
              "properties": {
                "name": {
                  "type": "string"
                }
              },
              "required": [
                "name"
              ],
              "type": "object"
            },
            "type": {
              "const": "ENVIRONMENT_REFERENCE",
              "type": "string"
            }
          },
          "required": [
            "content",
            "type"
          ],
          "type": "object"
        },
        {
          "properties": {
            "content": {
              "type": "string"
            },
            "type": {
              "const": "LITERAL_NON_SECRET",
              "type": "string"
            }
          },
          "required": [
            "content",
            "type"
          ],
          "type": "object"
        },
        {
          "properties": {
            "type": {
              "const": "REDACTED_UNKNOWN",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        }
      ]
    },
    "SelectionMetadata": {
      "additionalProperties": false,
      "properties": {
        "recommended": {
          "type": "boolean"
        },
        "score": {
          "format": "int16",
          "maximum": 32767,
          "minimum": -32768,
          "type": "integer"
        },
        "selected_by_default": {
          "type": "boolean"
        },
        "sensitive": {
          "type": "boolean"
        },
        "size_bytes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "recommended",
        "score",
        "selected_by_default",
        "sensitive",
        "size_bytes"
      ],
      "type": "object"
    },
    "VerificationRule": {
      "oneOf": [
        {
          "properties": {
            "content": {
              "properties": {
                "config": {
                  "$ref": "#/$defs/PathTokenInput"
                },
                "name": {
                  "type": "string"
                }
              },
              "required": [
                "config",
                "name"
              ],
