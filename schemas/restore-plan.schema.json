                    "null",
                    "string"
                  ]
                },
                "version": {
                  "type": [
                    "null",
                    "string"
                  ]
                }
              },
              "required": [
                "id"
              ],
              "type": "object"
            },
            "type": {
              "const": "INSTALL_VS_CODE_EXTENSION",
