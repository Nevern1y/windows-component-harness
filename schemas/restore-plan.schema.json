        "component",
        "id",
        "idempotency_key",
        "kind",
        "non_idempotent",
        "precondition",
        "prerequisites",
        "requires_elevation",
        "verification"
      ],
      "type": "object"
    },
    "OperationId": {
      "description": "Stable operation identity in the form `op_<run-id>_<decimal-ordinal>`.",
      "type": "string"
    },
