                  "$ref": "#/$defs/MergePolicy"
                }
              },
              "required": [
                "destination",
                "object",
                "policy"
              ],
              "type": "object"
            },
            "type": {
              "const": "MERGE_JSON",
              "type": "string"
            }
          },
          "required": [
            "content",
            "type"
          ],
          "type": "object"
        },
        {
          "properties": {
            "content": {
              "properties": {
                "destination": {
                  "$ref": "#/$defs/PathTokenInput"
                },
                "object": {
                  "$ref": "#/$defs/ObjectId"
                },
                "policy": {
                  "$ref": "#/$defs/MergePolicy"
                }
              },
              "required": [
                "destination",
                "object",
                "policy"
