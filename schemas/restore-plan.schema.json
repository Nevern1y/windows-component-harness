{
  "$defs": {
    "Architecture": {
      "enum": [
        "ARM64",
        "NEUTRAL",
        "UNKNOWN",
        "X64",
        "X86"
      ],
      "type": "string"
    },
    "ArtifactId": {
      "description": "Opaque artifact identifier. Its value is validated for safe wire transport.",
      "type": "string"
    },
    "ArtifactPolicy": {
      "enum": [
        "CONFIG",
        "DATA",
        "EXPORT",
        "LARGE_OPT_IN",
        "MANUAL",
        "PORTABLE_BINARY",
        "SECRET_REFERENCE"
      ],
      "type": "string"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "content_type": {
          "$ref": "#/$defs/ContentType"
        },
        "id": {
          "$ref": "#/$defs/ArtifactId"
        },
        "object": {
          "anyOf": [
            {
              "$ref": "#/$defs/ObjectId"
            },
            {
              "type": "null"
            }
          ]
        },
        "policy": {
          "$ref": "#/$defs/ArtifactPolicy"
        },
        "scope": {
          "$ref": "#/$defs/ConfigScope"
        },
        "size_bytes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "source_path": {
          "$ref": "#/$defs/PathTokenInput"
        }
      },
      "required": [
        "content_type",
        "id",
        "policy",
        "scope",
        "size_bytes",
        "source_path"
      ],
      "type": "object"
    },
    "ComponentId": {
      "description": "Stable component identity: `cmp_` followed by lowercase unpadded Base32 BLAKE3-256.",
      "type": "string"
    },
    "ComponentKind": {
      "enum": [
        "AGENT",
        "APPLICATION",
        "BROWSER",
        "BROWSER_PROFILE",
        "CONFIGURATION",
        "DATA_ARTIFACT",
        "DOCKER_CONTEXT",
        "DOCKER_IMAGE",
        "DOCKER_VOLUME",
        "EDITOR",
        "ENVIRONMENT_VARIABLE",
        "EXTENSION",
        "HARNESS",
        "HOOK",
        "MCP_SERVER",
        "PACKAGE",
        "PLUGIN",
        "PORTABLE_BINARY",
        "RUNTIME",
        "SCHEDULED_TASK",
        "SECRET_REFERENCE",
        "SERVICE",
        "SHELL",
        "SKILL",
        "SYSTEM_FEATURE",
        "TOOL",
        "UNKNOWN",
        "WSL_DISTRIBUTION"
      ],
      "type": "string"
    },
    "ConfigScope": {
      "enum": [
        "MANAGED",
        "PROCESS",
        "PROJECT",
        "SYSTEM",
        "USER"
      ],
      "type": "string"
    },
    "Conflict": {
      "additionalProperties": false,
      "properties": {
        "component": {
          "anyOf": [
            {
              "$ref": "#/$defs/ComponentId"
            },
            {
              "type": "null"
            }
          ]
        },
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ConflictKind"
        },
        "requires_confirmation": {
          "type": "boolean"
        },
        "resolution": {
          "$ref": "#/$defs/ConflictResolution"
        },
        "source_summary": {
          "type": "string"
        },
        "target_summary": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "requires_confirmation",
        "resolution",
        "source_summary",
        "target_summary"
      ],
      "type": "object"
    },
    "ConflictKind": {
      "enum": [
        "ALREADY_SATISFIED",
        "ARCHITECTURE_CONFLICT",
        "CONFIG_DIFFERENCE",
        "DATA_COLLISION",
        "DEPENDENCY_CONFLICT",
        "PATH_COLLISION",
        "PORT_COLLISION",
        "SECRET_COLLISION",
        "UNSUPPORTED_TARGET",
        "VERSION_DIFFERENCE"
      ],
      "type": "string"
    },
    "ConflictResolution": {
      "enum": [
        "INSTALL",
        "MANUAL",
        "MERGE",
        "PRESERVE_TARGET",
        "REPLACE",
        "SKIP"
      ],
      "type": "string"
    },
    "ContentType": {
      "enum": [
        "ARCHIVE",
        "BINARY",
        "JSON",
        "JSONC",
        "TOML",
        "UNKNOWN",
        "UTF8_TEXT"
      ],
      "type": "string"
    },
    "DockerImageSpec": {
      "additionalProperties": false,
      "properties": {
        "image_id": {
          "type": [
            "null",
            "string"
          ]
        },
        "repository": {
          "type": "string"
        },
        "tag": {
          "type": [
            "null",
            "string"
          ]
        }
      },
      "required": [
        "repository"
      ],
      "type": "object"
    },
    "DockerVolumeSpec": {
      "additionalProperties": false,
      "properties": {
        "driver": {
          "type": [
            "null",
            "string"
          ]
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "EnvBinding": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/SafeValueRef"
        }
      },
      "required": [
        "name",
        "value"
      ],
      "type": "object"
    },
    "ExecutableRef": {
      "additionalProperties": false,
      "properties": {
        "component": {
          "anyOf": [
            {
              "$ref": "#/$defs/ComponentId"
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "type": "string"
        },
        "observed_path": {
          "anyOf": [
            {
              "$ref": "#/$defs/PathTokenInput"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "FileMode": {
      "enum": [
        "CREATE_ONLY",
        "PRESERVE_TARGET",
        "REPLACE"
      ],
      "type": "string"
    },
    "KnownFolderToken": {
      "oneOf": [
        {
          "properties": {
            "content": {
              "properties": {
                "id": {
                  "type": "string"
                }
              },
              "required": [
                "id"
              ],
              "type": "object"
            },
            "type": {
              "const": "USER_SELECTED",
              "type": "string"
            }
          },
          "required": [
            "content",
            "type"
          ],
          "type": "object"
        },
        {
          "properties": {
            "type": {
              "const": "DESKTOP",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "properties": {
            "type": {
              "const": "DOCUMENTS",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "properties": {
            "type": {
              "const": "LOCAL_APP_DATA",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "properties": {
            "type": {
              "const": "PROGRAM_DATA",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "properties": {
            "type": {
              "const": "PROGRAM_FILES",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "properties": {
            "type": {
              "const": "PROGRAM_FILES_X86",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "properties": {
            "type": {
              "const": "ROAMING_APP_DATA",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "properties": {
            "type": {
              "const": "STARTUP",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "properties": {
            "type": {
              "const": "START_MENU",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "properties": {
            "type": {
              "const": "USER_PROFILE",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        }
      ]
    },
    "ManualAction": {
      "additionalProperties": false,
      "properties": {
        "acknowledged_at": {
          "format": "date-time",
          "type": [
            "null",
            "string"
          ]
        },
        "component": {
          "anyOf": [
            {
              "$ref": "#/$defs/ComponentId"
            },
            {
              "type": "null"
            }
          ]
        },
        "docs_url": {
          "format": "uri",
          "type": [
            "null",
            "string"
          ]
        },
        "id": {
          "type": "string"
        },
        "independent_operations_may_continue": {
          "type": "boolean"
        },
        "instructions": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "reason": {
          "type": "string"
        },
        "risk": {
          "$ref": "#/$defs/RiskLevel"
        },
        "state": {
          "$ref": "#/$defs/ManualActionState"
        },
        "title": {
          "type": "string"
        },
        "verification": {
          "anyOf": [
            {
              "$ref": "#/$defs/VerificationRule"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "independent_operations_may_continue",
        "instructions",
        "reason",
        "risk",
        "state",
        "title"
      ],
      "type": "object"
    },
    "ManualActionState": {
      "enum": [
        "ACKNOWLEDGED",
        "COMPLETED",
        "PENDING",
        "SKIPPED"
      ],
      "type": "string"
    },
    "McpEndpointWire": {
      "oneOf": [
        {
          "properties": {
            "content": {
              "format": "uri",
              "type": "string"
            },
            "type": {
              "const": "PUBLIC",
              "type": "string"
            }
          },
          "required": [
            "content",
            "type"
          ],
          "type": "object"
        },
        {
          "properties": {
            "content": {
              "properties": {
                "id": {
                  "$ref": "#/$defs/ComponentId"
                },
                "label": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "label"
              ],
              "type": "object"
            },
            "type": {
              "const": "SECRET_REFERENCE",
              "type": "string"
            }
          },
          "required": [
            "content",
            "type"
          ],
          "type": "object"
        },
        {
          "properties": {
            "content": {
              "properties": {
                "name": {
                  "type": "string"
                }
              },
              "required": [
                "name"
              ],
              "type": "object"
            },
            "type": {
              "const": "ENVIRONMENT_REFERENCE",
              "type": "string"
            }
          },
          "required": [
            "content",
            "type"
          ],
          "type": "object"
        },
        {
          "properties": {
            "type": {
              "const": "REDACTED_UNKNOWN",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        }
      ]
    },
    "McpServerSpec": {
      "additionalProperties": false,
      "properties": {
        "args": {
          "items": {
            "$ref": "#/$defs/SafeValueRef"
          },
          "type": "array"
        },
        "command": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExecutableRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "cwd": {
          "anyOf": [
            {
              "$ref": "#/$defs/McpWorkingDirectory"
            },
            {
              "type": "null"
            }
          ]
        },
        "endpoint": {
          "anyOf": [
            {
              "$ref": "#/$defs/McpEndpointWire"
            },
            {
              "type": "null"
            }
          ]
        },
        "environment": {
          "items": {
            "$ref": "#/$defs/EnvBinding"
          },
          "type": "array"
        },
        "name": {
          "type": "string"
        },
        "required_package": {
          "anyOf": [
            {
              "$ref": "#/$defs/PackageSpec"
            },
            {
              "type": "null"
            }
          ]
        },
        "required_runtime": {
          "anyOf": [
            {
              "$ref": "#/$defs/ComponentId"
            },
            {
              "type": "null"
            }
          ]
        },
        "scope": {
          "$ref": "#/$defs/ConfigScope"
        },
        "source_config": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "transport": {
          "$ref": "#/$defs/McpTransport"
        }
      },
      "required": [
        "args",
        "environment",
        "name",
        "scope",
        "source_config",
        "transport"
      ],
      "type": "object"
    },
    "McpTransport": {
      "enum": [
        "SSE",
        "STDIO",
        "STREAMABLE_HTTP",
        "UNKNOWN"
      ],
      "type": "string"
    },
    "McpWorkingDirectory": {
      "oneOf": [
        {
          "properties": {
            "content": {
              "$ref": "#/$defs/PathTokenInput"
            },
            "type": {
              "const": "TOKENIZED",
              "type": "string"
            }
          },
          "required": [
            "content",
            "type"
          ],
          "type": "object"
        },
        {
          "properties": {
            "content": {
              "properties": {
                "id": {
                  "$ref": "#/$defs/ComponentId"
                },
                "label": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "label"
              ],
              "type": "object"
            },
            "type": {
              "const": "SECRET_REFERENCE",
              "type": "string"
            }
          },
          "required": [
            "content",
            "type"
          ],
          "type": "object"
        },
        {
          "properties": {
            "content": {
              "properties": {
                "name": {
                  "type": "string"
                }
              },
              "required": [
                "name"
              ],
              "type": "object"
            },
            "type": {
              "const": "ENVIRONMENT_REFERENCE",
              "type": "string"
            }
          },
          "required": [
            "content",
            "type"
          ],
          "type": "object"
        },
        {
          "properties": {
            "type": {
              "const": "REDACTED_UNKNOWN",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        }
      ]
    },
    "MergePolicy": {
      "enum": [
        "APPEND_UNIQUE",
        "MANUAL_ON_CONFLICT",
        "PRESERVE_UNKNOWN",
        "REPLACE_KNOWN_KEYS"
      ],
      "type": "string"
    },
    "ObjectId": {
      "description": "Content-addressed object identity: `obj_` followed by lowercase hexadecimal BLAKE3-256.",
      "type": "string"
    },
    "Operation": {
      "additionalProperties": false,
      "properties": {
        "component": {
          "$ref": "#/$defs/ComponentId"
        },
        "id": {
          "$ref": "#/$defs/OperationId"
        },
        "idempotency_key": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/OperationKind"
        },
        "non_idempotent": {
          "type": "boolean"
        },
        "precondition": {
          "$ref": "#/$defs/Precondition"
        },
        "prerequisites": {
          "items": {
            "$ref": "#/$defs/OperationId"
          },
          "type": "array"
        },
        "requires_elevation": {
          "type": "boolean"
        },
        "verification": {
          "items": {
            "$ref": "#/$defs/VerificationRule"
          },
          "type": "array"
        }
