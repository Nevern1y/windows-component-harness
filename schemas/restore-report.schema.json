{
  "$defs": {
    "Architecture": {
      "enum": [
        "X86",
        "X64",
        "ARM64",
        "NEUTRAL",
        "UNKNOWN"
      ],
      "type": "string"
    },
    "ComponentId": {
      "description": "Stable component identity: `cmp_` followed by lowercase unpadded Base32 BLAKE3-256.",
      "type": "string"
    },
    "ComponentKind": {
      "enum": [
        "APPLICATION",
        "PACKAGE",
        "RUNTIME",
        "TOOL",
        "HARNESS",
        "MCP_SERVER",
        "SKILL",
        "AGENT",
        "HOOK",
        "PLUGIN",
        "BROWSER",
        "BROWSER_PROFILE",
        "EDITOR",
        "EXTENSION",
        "CONFIGURATION",
        "DATA_ARTIFACT",
        "SECRET_REFERENCE",
        "ENVIRONMENT_VARIABLE",
        "SYSTEM_FEATURE",
        "SERVICE",
        "SCHEDULED_TASK",
        "SHELL",
        "PORTABLE_BINARY",
        "WSL_DISTRIBUTION",
        "DOCKER_CONTEXT",
        "DOCKER_IMAGE",
        "DOCKER_VOLUME",
        "UNKNOWN"
      ],
      "type": "string"
    },
    "ComponentReport": {
      "additionalProperties": false,
      "properties": {
        "component": {
          "$ref": "#/$defs/ComponentId"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/VerificationEvidence"
          },
          "type": "array"
        },
        "manual_actions": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "status": {
          "$ref": "#/$defs/ReportStatus"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "component",
        "status",
        "evidence",
        "manual_actions",
        "warnings"
      ],
      "type": "object"
    },
    "ConfigScope": {
      "enum": [
        "PROCESS",
        "USER",
        "SYSTEM",
        "PROJECT",
        "MANAGED"
      ],
      "type": "string"
    },
    "ContentType": {
      "enum": [
        "UTF8_TEXT",
        "JSON",
        "JSONC",
        "TOML",
        "BINARY",
        "ARCHIVE",
        "UNKNOWN"
      ],
      "type": "string"
    },
    "KnownFolderToken": {
      "oneOf": [
        {
          "properties": {
            "type": {
              "const": "USER_PROFILE",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "properties": {
            "type": {
              "const": "ROAMING_APP_DATA",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "properties": {
            "type": {
              "const": "LOCAL_APP_DATA",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "properties": {
            "type": {
              "const": "PROGRAM_DATA",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "properties": {
            "type": {
              "const": "PROGRAM_FILES",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "properties": {
            "type": {
              "const": "PROGRAM_FILES_X86",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "properties": {
            "type": {
              "const": "START_MENU",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "properties": {
            "type": {
              "const": "STARTUP",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "properties": {
            "type": {
              "const": "DESKTOP",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "properties": {
            "type": {
              "const": "DOCUMENTS",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "properties": {
            "content": {
              "properties": {
                "id": {
                  "type": "string"
                }
              },
              "required": [
                "id"
              ],
              "type": "object"
            },
            "type": {
              "const": "USER_SELECTED",
              "type": "string"
            }
          },
          "required": [
            "type",
            "content"
          ],
          "type": "object"
        }
      ]
    },
    "ManualAction": {
      "additionalProperties": false,
      "properties": {
        "acknowledged_at": {
          "format": "date-time",
          "type": [
            "string",
            "null"
          ]
        },
        "component": {
          "anyOf": [
            {
              "$ref": "#/$defs/ComponentId"
            },
            {
              "type": "null"
            }
          ]
        },
        "docs_url": {
          "format": "uri",
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": "string"
        },
        "independent_operations_may_continue": {
          "type": "boolean"
        },
        "instructions": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "reason": {
          "type": "string"
        },
        "risk": {
          "$ref": "#/$defs/RiskLevel"
        },
        "state": {
          "$ref": "#/$defs/ManualActionState"
        },
        "title": {
          "type": "string"
        },
        "verification": {
          "anyOf": [
            {
              "$ref": "#/$defs/VerificationRule"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "title",
        "reason",
        "risk",
        "instructions",
        "state",
        "independent_operations_may_continue"
      ],
      "type": "object"
    },
    "ManualActionState": {
      "enum": [
        "PENDING",
        "ACKNOWLEDGED",
        "COMPLETED",
        "SKIPPED"
      ],
      "type": "string"
    },
    "ObjectId": {
      "description": "Content-addressed object identity: `obj_` followed by lowercase hexadecimal BLAKE3-256.",
      "type": "string"
    },
    "PackageSpec": {
      "additionalProperties": false,
      "properties": {
        "architecture": {
          "anyOf": [
            {
              "$ref": "#/$defs/Architecture"
            },
            {
              "type": "null"
            }
          ]
        },
        "id": {
          "type": "string"
        },
        "installer_hash": {
          "type": [
            "string",
            "null"
          ]
        },
        "provider": {
          "$ref": "#/$defs/ProviderId"
        },
        "source": {
          "format": "uri",
          "type": [
            "string",
            "null"
          ]
        },
        "source_identifier": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "version": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "provider",
        "id"
      ],
      "type": "object"
    },
    "PathTokenInput": {
      "additionalProperties": false,
      "properties": {
        "relative": {
          "type": "string"
        },
        "root": {
          "$ref": "#/$defs/KnownFolderToken"
        }
      },
      "required": [
        "root",
        "relative"
      ],
      "type": "object"
    },
    "ProviderId": {
      "description": "Opaque provider identifier. Its value is validated for safe wire transport.",
      "type": "string"
    },
    "Publisher": {
      "additionalProperties": false,
      "properties": {
        "certificate_thumbprint": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "ReportCounts": {
      "additionalProperties": false,
      "properties": {
        "already_present": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "failed": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "partial": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "reauth_required": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "reboot_required": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "unsupported": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "verified": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "waiting_for_user": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "verified",
        "partial",
        "already_present",
        "waiting_for_user",
        "reauth_required",
        "reboot_required",
        "unsupported",
        "failed"
      ],
      "type": "object"
    },
    "ReportStatus": {
      "enum": [
        "VERIFIED",
        "PARTIALLY_VERIFIED",
        "ALREADY_PRESENT",
        "SKIPPED",
        "WAITING_FOR_USER",
        "REAUTH_REQUIRED",
        "REBOOT_REQUIRED",
        "UNSUPPORTED",
        "FAILED"
      ],
      "type": "string"
    },
    "RiskLevel": {
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH",
        "CRITICAL"
      ],
      "type": "string"
    },
    "RunId": {
      "description": "UUIDv7 run identifier used to correlate resumable operations and journal events.",
      "type": "string"
    },
    "SafeValueRef": {
      "oneOf": [
        {
          "properties": {
            "content": {
              "type": "string"
            },
            "type": {
              "const": "LITERAL_NON_SECRET",
              "type": "string"
            }
          },
          "required": [
            "type",
            "content"
          ],
          "type": "object"
        },
        {
          "properties": {
            "content": {
              "properties": {
                "name": {
                  "type": "string"
                }
              },
              "required": [
                "name"
              ],
              "type": "object"
            },
            "type": {
              "const": "ENVIRONMENT_REFERENCE",
              "type": "string"
            }
          },
          "required": [
            "type",
            "content"
          ],
          "type": "object"
        },
        {
          "properties": {
            "content": {
              "properties": {
                "id": {
                  "$ref": "#/$defs/ComponentId"
                },
                "label": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "label"
              ],
              "type": "object"
            },
            "type": {
              "const": "SECRET_REFERENCE",
              "type": "string"
            }
          },
          "required": [
            "type",
            "content"
          ],
          "type": "object"
        },
        {
          "properties": {
            "type": {
              "const": "REDACTED_UNKNOWN",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        }
      ]
    },
    "VerificationEvidence": {
      "additionalProperties": false,
      "properties": {
        "observed_at": {
          "format": "date-time",
          "type": "string"
        },
        "rule": {
          "$ref": "#/$defs/VerificationRule"
        },
        "status": {
          "$ref": "#/$defs/ReportStatus"
        },
        "summary": {
          "type": "string"
        }
      },
      "required": [
        "rule",
        "status",
        "summary",
        "observed_at"
      ],
      "type": "object"
    },
    "VerificationRule": {
      "oneOf": [
        {
          "properties": {
            "content": {
              "properties": {
                "package": {
                  "$ref": "#/$defs/PackageSpec"
                },
                "provider": {
                  "$ref": "#/$defs/ProviderId"
                }
              },
              "required": [
                "provider",
                "package"
              ],
              "type": "object"
            },
            "type": {
              "const": "PROVIDER_IDENTITY",
              "type": "string"
            }
          },
          "required": [
            "type",
            "content"
          ],
          "type": "object"
        },
        {
          "properties": {
            "content": {
              "properties": {
                "destination": {
                  "$ref": "#/$defs/PathTokenInput"
                },
                "object": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/ObjectId"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "destination"
              ],
              "type": "object"
            },
            "type": {
              "const": "FILE",
              "type": "string"
            }
          },
          "required": [
            "type",
            "content"
          ],
          "type": "object"
        },
        {
          "properties": {
            "content": {
              "properties": {
                "destination": {
                  "$ref": "#/$defs/PathTokenInput"
                },
                "publisher": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/Publisher"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "version": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/VersionValue"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "destination"
              ],
              "type": "object"
            },
            "type": {
              "const": "FILE_VERSION",
              "type": "string"
            }
          },
          "required": [
            "type",
            "content"
          ],
          "type": "object"
        },
        {
          "properties": {
            "content": {
              "properties": {
                "content_type": {
                  "$ref": "#/$defs/ContentType"
                },
                "destination": {
                  "$ref": "#/$defs/PathTokenInput"
                }
              },
              "required": [
                "destination",
                "content_type"
              ],
              "type": "object"
            },
            "type": {
              "const": "CONFIG_PARSES",
              "type": "string"
            }
          },
          "required": [
            "type",
            "content"
          ],
          "type": "object"
        },
        {
          "properties": {
            "content": {
              "properties": {
                "expected": {
                  "$ref": "#/$defs/SafeValueRef"
                },
                "name": {
                  "type": "string"
                },
                "scope": {
                  "$ref": "#/$defs/ConfigScope"
                }
              },
              "required": [
                "scope",
                "name",
                "expected"
              ],
              "type": "object"
            },
            "type": {
              "const": "ENVIRONMENT",
              "type": "string"
            }
          },
          "required": [
            "type",
            "content"
          ],
          "type": "object"
        },
        {
          "properties": {
            "content": {
              "properties": {
                "config": {
                  "$ref": "#/$defs/PathTokenInput"
                },
                "name": {
                  "type": "string"
                }
              },
              "required": [
                "name",
                "config"
              ],
              "type": "object"
            },
            "type": {
              "const": "MCP_REGISTRATION",
              "type": "string"
            }
          },
          "required": [
            "type",
            "content"
          ],
          "type": "object"
        },
        {
          "properties": {
            "content": {
              "properties": {
                "distro": {
                  "type": "string"
                },
                "version": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "distro"
              ],
              "type": "object"
            },
            "type": {
              "const": "WSL_STATE",
              "type": "string"
            }
          },
          "required": [
            "type",
            "content"
          ],
          "type": "object"
        },
        {
          "properties": {
            "content": {
              "properties": {
                "identity": {
                  "type": "string"
                },
                "kind": {
                  "$ref": "#/$defs/ComponentKind"
                }
              },
              "required": [
                "kind",
                "identity"
              ],
              "type": "object"
            },
            "type": {
              "const": "DOCKER_OBJECT",
              "type": "string"
            }
          },
          "required": [
            "type",
            "content"
          ],
          "type": "object"
        },
        {
          "properties": {
            "content": {
              "properties": {
                "profile": {
                  "$ref": "#/$defs/PathTokenInput"
                }
              },
              "required": [
                "profile"
              ],
              "type": "object"
            },
            "type": {
              "const": "BROWSER_ARTIFACT",
              "type": "string"
            }
          },
          "required": [
            "type",
            "content"
          ],
          "type": "object"
        },
        {
          "properties": {
            "content": {
              "properties": {
                "secret": {
                  "$ref": "#/$defs/ComponentId"
                }
              },
              "required": [
                "secret"
              ],
              "type": "object"
            },
            "type": {
              "const": "SECURE_TARGET",
              "type": "string"
            }
          },
          "required": [
            "type",
            "content"
          ],
          "type": "object"
        }
      ]
    },
    "VersionValue": {
      "additionalProperties": false,
      "properties": {
        "normalized": {
          "type": [
            "string",
            "null"
          ]
        },
        "raw": {
          "type": "string"
        }
      },
      "required": [
        "raw"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "bytes_written": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "components": {
      "items": {
        "$ref": "#/$defs/ComponentReport"
      },
      "type": "array"
    },
    "counts": {
      "$ref": "#/$defs/ReportCounts"
    },
    "elapsed_ms": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "format_version": {
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0,
      "type": "integer"
    },
    "manual_actions": {
      "items": {
        "$ref": "#/$defs/ManualAction"
      },
      "type": "array"
    },
    "package_id": {
      "type": "string"
    },
    "run_id": {
      "$ref": "#/$defs/RunId"
    },
    "status": {
      "$ref": "#/$defs/ReportStatus"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "format_version",
    "run_id",
    "package_id",
    "status",
    "counts",
    "components",
    "manual_actions",
    "warnings",
    "elapsed_ms",
    "bytes_written"
  ],
  "title": "RestoreReport",
  "type": "object"
}
