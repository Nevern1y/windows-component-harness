{
  "name": "reforge",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "ui:build": "pnpm --filter @reforge/ui build",
    "ui:check": "pnpm --filter @reforge/ui check",
    "ui:test": "pnpm --filter @reforge/ui test",
    "desktop:build": "cargo build --workspace --locked",
    "cli:build": "cargo build --locked -p reforge-cli"
  }
}
